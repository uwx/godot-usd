[configuration]

entry_symbol = "godot_usd_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/linux-x86_64/libgodot_usd.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux-x86_64/libgodot_usd.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/linux-arm64/libgodot_usd.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/linux-arm64/libgodot_usd.linux.template_release.arm64.so"
windows.debug.x86_64 = "res://bin/windows-x86_64/libgodot_usd.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows-x86_64/libgodot_usd.windows.template_release.x86_64.dll"
windows.debug.arm64 = "res://bin/windows-arm64/libgodot_usd.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://bin/windows-arm64/libgodot_usd.windows.template_release.arm64.dll"
macos.debug.arm64 = "res://bin/macos-arm64/libgodot_usd.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://bin/macos-arm64/libgodot_usd.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "res://bin/macos-x86_64/libgodot_usd.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "res://bin/macos-x86_64/libgodot_usd.macos.template_release.x86_64.dylib"
android.debug.arm64 = "res://bin/android-arm64/libgodot_usd.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/android-arm64/libgodot_usd.android.template_release.arm64.so"
android.debug.x86_64 = "res://bin/android-x86_64/libgodot_usd.android.template_debug.x86_64.so"
android.release.x86_64 = "res://bin/android-x86_64/libgodot_usd.android.template_release.x86_64.so"
ios.debug.arm64 = "res://bin/ios-arm64/libgodot_usd.ios.template_debug.arm64.dylib"
ios.release.arm64 = "res://bin/ios-arm64/libgodot_usd.ios.template_release.arm64.dylib"
web.debug.wasm32 = "res://bin/web-wasm32/libgodot_usd.web.template_debug.wasm32.wasm"
web.release.wasm32 = "res://bin/web-wasm32/libgodot_usd.web.template_release.wasm32.wasm"
